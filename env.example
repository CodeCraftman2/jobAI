# JobAI configuration
#
# Copy this file to .env (or run `npm run setup`). Most of it can also be set
# in the app: the first-run wizard and Settings write these values for you.
#
# API KEYS ARE NOT KEPT HERE. When you enter a key in the app it is stored in
# your operating system's keychain (Windows Credential/DPAPI, macOS Keychain,
# Linux Secret Service) and the line below is left empty. A key typed into
# this file is moved into the keychain the next time the app starts. Only on
# a system without a keychain does a key stay in this file.


# ── AI: Google Gemini (REQUIRED) ─────────────────────────────────────────
# Answers interview questions and is the automatic fallback whenever any
# other AI fails. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=


# ── AI: other provider (OPTIONAL) ────────────────────────────────────────
# Used for coding questions and screenshots. Leave empty to use Gemini only.
# Any OpenAI- or Anthropic-style endpoint works. You can also paste a curl
# command in the setup wizard or Settings and these are filled in for you.
GATEWAY_API_KEY=

# Where the provider lives. Examples:
#   OpenRouter  https://openrouter.ai/api/v1
#   Kilo        https://api.kilo.ai/api/gateway
#   Groq        https://api.groq.com/openai/v1
# Blank: OpenRouter if the key starts with sk-or-, otherwise Anthropic.
GATEWAY_BASE_URL=

# Wire format and credential header. Blank means detect from the URL.
#   GATEWAY_FORMAT: openai | anthropic        GATEWAY_AUTH: bearer | x-api-key
GATEWAY_FORMAT=
GATEWAY_AUTH=

# Models to use, comma separated, best first. Leave empty to let the app find
# working models itself and switch between them when one fails.
GATEWAY_MODELS=
# Find working models automatically (always on for OpenRouter unless "false").
GATEWAY_DISCOVERY=true
# Only use free models when the provider says which are free.
GATEWAY_FREE_ONLY=false
# Reasoning effort for models that support it: low | medium | high | xhigh | max
GATEWAY_EFFORT=

# Which AI answers: gemini | gateway. With both keys set, Gemini answers
# interview questions and the other provider answers coding questions.
LLM_PROVIDER=gemini
# auto = route each mode to its best model; off = always use LLM_PROVIDER.
LLM_ROUTING=auto


# ── Answering behaviour ──────────────────────────────────────────────────
# Only send questions and requests to the AI (false: answer everything).
JOBAI_QUESTION_FILTER=true
# Language used for code in answers: cpp | c | python | java | javascript
JOBAI_CODING_LANGUAGE=cpp
# dsa = coding-interview problems; interview = behavioral, system design and everything else
JOBAI_ACTIVE_SKILL=dsa
# Attach a screenshot when a spoken question is answered.
JOBAI_AUTO_SCREEN=true
# If no AI model can read images, read the screenshot with local OCR and send
# the text instead. The language data (about 2 MB) is downloaded once by the
# setup wizard or `npm run setup-ocr`. Set false to turn this off.
JOBAI_OCR_FALLBACK=true
# Where the OCR data is kept (default: the app data folder).
# OCR_DATA_DIR=


# ── Privacy and limits ───────────────────────────────────────────────────
# Before anything is sent to an AI provider, API keys, tokens and passwords in
# the text (including text read from the screen) are replaced with [redacted],
# and the amount sent is capped. Screenshots are shrunk to 1600 px.
# Most characters of conversation history and the current question sent at once.
JOBAI_MAX_CONTEXT_CHARS=30000
# Most characters in any single message.
JOBAI_MAX_PART_CHARS=12000
# Most requests to the AI provider running at the same time.
JOBAI_MAX_CONCURRENT_REQUESTS=3
# Log files record what happened, not what was said. true also logs questions
# and answers (for debugging only; secrets are still redacted).
# LOG_CONTENT=false


# ── Speech recognition ───────────────────────────────────────────────────
# whisper (local, free, private) | azure (cloud)
SPEECH_PROVIDER=whisper

# Local Whisper. The setup wizard installs it and fills WHISPER_COMMAND.
#   pip install openai-whisper       (macOS also: brew install ffmpeg sox)
# Windows example: .venv-whisper/Scripts/whisper.exe
WHISPER_COMMAND=whisper
WHISPER_MODEL=small.en
WHISPER_LANGUAGE=en
WHISPER_DEVICE=auto
WHISPER_PYTHON=
# Absolute path to keep model weights elsewhere (default: the app data folder).
# WHISPER_MODEL_DIR=

# Capture: vad ends a chunk at a pause; manual records until you stop.
WHISPER_CAPTURE_MODE=vad
WHISPER_SEGMENT_MS=4000
WHISPER_MANUAL_MAX_MS=90000
WHISPER_GPU_IDLE_MS=60000
# Latency: end a chunk after a short pause and cap chunks so answers start sooner.
WHISPER_SILENCE_HANGOVER_MS=500
WHISPER_MAX_UTTERANCE_MS=8000

# Azure Speech (only if SPEECH_PROVIDER=azure). The key goes in the keychain.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
